<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Títol gran de cada pantalla -->
    <style name="TitolPantalla">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_principal</item>
    </style>

    <!-- Text normal, explicacions -->
    <style name="TextNormal">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secundari</item>
    </style>

    <!-- Etiqueta d'una secció o d'una pregunta -->
    <style name="TextEtiqueta">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_principal</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>

    <!-- Botó ple (acció principal) -->
    <style name="BotoPrincipal" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Botó amb vora (acció secundària) -->
    <style name="BotoSecundari" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Camp de text amb vora -->
    <style name="CampText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <!-- Bafarada del panell d'ajuda -->
    <style name="Bafarada">
        <item name="android:background">@drawable/fons_bafarada</item>
        <item name="android:padding">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_principal</item>
    </style>
</resources>
